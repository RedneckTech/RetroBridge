# RetroBridge environment configuration
# Copy this to .env and fill in your values.
# Loaded automatically by python-dotenv at startup.

FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string
# SQLite paths may be absolute or relative to the project root.
# Relative paths (like instance/retrobridge_dev.db) are normalized to absolute
# paths anchored at the project root at startup by the shared config layer.
DATABASE_URL=sqlite:///instance/retrobridge_dev.db

# Production overrides (uncomment in production):
# FLASK_ENV=production
# SECRET_KEY=<generate a long random string>
# DATABASE_URL is **required** in production — no implicit fallback is allowed.
# DATABASE_URL=sqlite:///instance/retrobridge.db
# BACKUP_DIR=/var/lib/retrobridge/backups
# BACKUP_RETENTION_DAYS=30
# BACKUP_RETENTION_COUNT=10

# Patreon integration (configure in admin settings or here):
# PATREON_CLIENT_ID=
# PATREON_CLIENT_SECRET=
# PATREON_CAMPAIGN_ID=
